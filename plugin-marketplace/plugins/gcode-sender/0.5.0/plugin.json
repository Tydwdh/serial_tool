{
  "$schema": "../plugin.schema.json",
  "id": "gcode-sender",
  "name": "G-code Sender",
  "version": "0.5.0",
  "api_version": "0.1",
  "runtime": "lua",
  "main": "main.lua",
  "description": "面向 Marlin 固件的 G-code 发送器：支持文件/单条发送、行号校验、暂停/恢复/取消、进度显示",
  "author": "Tydwdh",
  "homepage": "https://github.com/Tydwdh/serial_tool",
  "repository": "https://github.com/Tydwdh/serial_tool",
  "license": "MIT",
  "category": "gcode",
  "permissions": [
    "bus",
    "log",
    "serial",
    "ui",
    "dialog",
    "fs.read.user_selected",
    "task",
    "config"
  ],
  "contributes": {
    "commands": [
      {
        "id": "gcode-sender.send_file",
        "title": "G文件"
      },
      {
        "id": "gcode-sender.send_single",
        "title": "G单条"
      },
      {
        "id": "gcode-sender.pause",
        "title": "暂停/恢复"
      },
      {
        "id": "gcode-sender.cancel",
        "title": "取消"
      }
    ],
    "settings": [
      {
        "id": "default_setup_gcode",
        "title": "初始化 G-code",
        "kind": "text",
        "default": "",
        "description": "文件和单条发送前执行的可选 G-code；默认留空，避免意外修改设备参数"
      },
      {
        "id": "append_program_end",
        "title": "自动追加 M2",
        "kind": "boolean",
        "default": false,
        "description": "输入末尾没有 M2/M30 时自动追加 M2；默认关闭，不改写原始作业"
      },
      {
        "id": "omit_line_numbers",
        "title": "不添加行号校验",
        "kind": "boolean",
        "default": false,
        "description": "发送原始 G-code 行（不加 N 行号与 * 校验和），依赖固件无校验模式；注意此时无法检测丢行，设备也不会请求重传"
      },
      {
        "id": "ack_timeout_ms",
        "title": "ACK 超时 (ms)",
        "kind": "number",
        "default": 300000,
        "min": 1000,
        "max": 600000,
        "step": 1000,
        "description": "等待设备响应的空闲超时；收到 busy/keepalive 后会重新计时"
      },
      {
        "id": "start_timeout_ms",
        "title": "启动同步超时 (ms)",
        "kind": "number",
        "default": 3000,
        "min": 500,
        "max": 30000,
        "step": 500,
        "description": "M110 行号同步的单次超时"
      },
      {
        "id": "eof_delay_ms",
        "title": "结束延迟 (ms)",
        "kind": "number",
        "default": 1000,
        "min": 0,
        "max": 10000,
        "step": 100,
        "description": "发送完成后的等待时间"
      },
      {
        "id": "error_followup_ms",
        "title": "错误后续读取 (ms)",
        "kind": "number",
        "default": 2000,
        "min": 100,
        "max": 10000,
        "step": 100,
        "description": "收到 Error 后继续读取响应的时间"
      },
      {
        "id": "max_marlin_line_bytes",
        "title": "最大行长度 (字节)",
        "kind": "number",
        "default": 96,
        "min": 32,
        "max": 256,
        "step": 8,
        "description": "包含行号和校验和后的最大行长；任一行超限会阻止整个作业发送"
      },
      {
        "id": "max_retries",
        "title": "单行最大重试次数",
        "kind": "number",
        "default": 3,
        "min": 0,
        "max": 20,
        "step": 1,
        "description": "ACK 超时、未知命令或设备请求重传时的最大额外尝试次数；设为 0 时不重试"
      }
    ],
    "ui": [
      {
        "id": "gcode-sender.progress",
        "slot": "status_bar.left",
        "kind": "progress",
        "title": "",
        "tooltip": "设备已确认接收的 G-code 行数",
        "order": 10
      },
      {
        "id": "gcode-sender.send_file.button",
        "slot": "send.toolbar",
        "kind": "button",
        "command": "gcode-sender.send_file",
        "tooltip": "选择并发送 Marlin G-code 文件；发送区中的单行文件路径也可直接使用",
        "record_send_input": true,
        "order": 20
      },
      {
        "id": "gcode-sender.send_single.button",
        "slot": "send.toolbar",
        "kind": "button",
        "command": "gcode-sender.send_single",
        "tooltip": "发送初始化 G-code 和当前输入，并添加行号与校验；是否补 M2 由设置决定",
        "record_send_input": true,
        "order": 21
      },
      {
        "id": "gcode-sender.pause.button",
        "slot": "send.toolbar",
        "kind": "button",
        "command": "gcode-sender.pause",
        "tooltip": "暂停或恢复继续下发新指令；设备已缓存的指令仍可能继续执行",
        "order": 23
      },
      {
        "id": "gcode-sender.cancel.button",
        "slot": "send.toolbar",
        "kind": "button",
        "command": "gcode-sender.cancel",
        "tooltip": "停止继续下发新指令；这不是急停，设备已缓存的指令仍可能继续执行",
        "order": 24
      }
    ]
  }
}
