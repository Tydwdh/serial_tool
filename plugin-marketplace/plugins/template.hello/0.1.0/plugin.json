{
  "$schema": "../plugin.schema.json",
  "id": "template.hello",
  "name": "Hello 插件模板",
  "version": "0.1.0",
  "api_version": "0.1",
  "runtime": "lua",
  "main": "main.lua",
  "description": "最小可用插件模板：一个参数表单，演示 bus/log/ui/storage 权限的基本用法",
  "author": "Tydwdh",
  "homepage": "https://github.com/Tydwdh/serial_tool",
  "repository": "https://github.com/Tydwdh/serial_tool",
  "license": "MIT",
  "category": "template",
  "permissions": ["bus", "log", "ui", "storage"],
  "live": {
    "main": "main.lua",
    "permissions": ["bus", "log", "ui", "storage"]
  },
  "contributes": {
    "panels": [
      {
        "id": "template.hello.form",
        "title": "Hello 参数",
        "kind": "form",
        "auto_apply": true,
        "fields": [
          { "id": "message", "label": "消息", "kind": "text", "default": "hello hardware workbench" },
          {
            "id": "level", "label": "日志级别", "kind": "select", "default": "info",
            "options": [
              { "label": "Info", "value": "info" },
              { "label": "Warn", "value": "warn" },
              { "label": "Error", "value": "error" }
            ]
          },
          { "id": "enabled", "label": "启用输出", "kind": "checkbox", "default": true }
        ]
      }
    ]
  }
}
