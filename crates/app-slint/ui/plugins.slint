import { Button, CheckBox, ComboBox, GroupBox, LineEdit, Slider, VerticalBox, HorizontalBox, TabWidget, ProgressIndicator } from "std-widgets.slint";
import { AppColors } from "palette.slint";

export struct PluginRow { id: string, name: string, version: string, state: string, enabled: bool }
export struct MarketRow { id: string, name: string, version: string, desc: string, installed: bool, progress: float }

export component PluginsView inherits Rectangle {
    in-out property <int> tab: 0; // 0 已安装 1 市场
    in-out property <string> search: "";
    in-out property <string> market-search: "";
    in-out property <[PluginRow]> installed: [];
    in-out property <[MarketRow]> market: [];
    in-out property <string> summary: "";
    in-out property <string> market-error: "";
    in-out property <bool> market-refreshing: false;

    callback refresh-market();
    callback install(string);
    callback toggle(string);
    callback uninstall(string);
    callback restart(string);

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        // Tab
        HorizontalBox {
            spacing: 8px;
            Button { text: "已安装"; primary: root.tab == 0; clicked => { root.tab = 0; } }
            Button { text: "市场"; primary: root.tab == 1; clicked => { root.tab = 1; } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.summary; color: AppColors.text-dimmed; font-size: 11px; vertical-alignment: center; }
        }
        if root.tab == 0 : VerticalBox {
            spacing: 8px;
            LineEdit { placeholder-text: "搜索已安装插件"; text <=> root.search; }
            VerticalBox {
                spacing: 6px;
                for row in root.installed : Rectangle {
                    height: 56px;
                    background: AppColors.bg-card;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: AppColors.border;
                    HorizontalBox {
                        padding: 8px;
                        spacing: 8px;
                        VerticalBox {
                            spacing: 2px;
                            Text { text: row.name + " v" + row.version; font-weight: 700; font-size: 12px; }
                            Text { text: row.id + " · " + row.state; color: AppColors.text-secondary; font-size: 11px; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: row.enabled ? "禁用" : "启用"; clicked => { root.toggle(row.id); } }
                        Button { text: "重启"; clicked => { root.restart(row.id); } }
                        Button { text: "卸载"; clicked => { root.uninstall(row.id); } }
                    }
                }
                if root.installed.length == 0 : Text { text: "未发现插件 — 将扫描 plugins/ 目录"; color: AppColors.text-dimmed; horizontal-alignment: center; }
            }
        }
        if root.tab == 1 : VerticalBox {
            spacing: 8px;
            HorizontalBox {
                spacing: 8px;
                LineEdit { placeholder-text: "搜索市场"; text <=> root.market-search; horizontal-stretch: 1; }
                Button { text: root.market-refreshing ? "刷新中…" : "刷新"; clicked => { root.refresh-market(); } }
            }
            if root.market-error != "" : Text { text: root.market-error; color: AppColors.red; font-size: 11px; wrap: word-wrap; }
            for row in root.market : Rectangle {
                height: row.progress > 0 ? 72px : 56px;
                background: AppColors.bg-card;
                border-radius: 8px;
                border-width: 1px;
                border-color: AppColors.border;
                VerticalBox {
                    padding: 8px;
                    spacing: 4px;
                    HorizontalBox {
                        spacing: 8px;
                        Text { text: row.name; font-weight: 700; }
                        Text { text: "v" + row.version; color: AppColors.text-dimmed; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: row.installed ? "已安装" : "安装"; enabled: !row.installed && row.progress == 0; clicked => { root.install(row.id); } }
                    }
                    Text { text: row.desc; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
                    if row.progress > 0 : ProgressIndicator { progress: row.progress; }
                }
            }
        }
    }
}

export struct DynamicFieldRow { id: string, label: string, kind: string, value: string, visible: bool, enabled: bool, options: [string] }

export component DynamicFormView inherits Rectangle {
    in-out property <string> panel-id: "";
    in-out property <string> title: "";
    in-out property <[DynamicFieldRow]> fields: [];
    in-out property <string> fields-json: "[]"; // 兼容旧链路，回退展示
    callback field-changed(string, string);
    callback field-action(string);

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        Text { text: root.title == "" ? "动态面板" : root.title; font-weight: 700; }
        if root.fields.length > 0 : VerticalBox {
            spacing: 8px;
            for f in root.fields : VerticalBox {
                spacing: 4px;
                if f.visible : HorizontalBox {
                    spacing: 8px;
                    Text { text: f.label; width: 96px; vertical-alignment: center; color: f.enabled ? AppColors.text-primary : AppColors.text-dimmed; }
                    if f.kind == "separator" : Rectangle { height: 1px; background: AppColors.separator; horizontal-stretch: 1; }
                    if f.kind == "label" : Text { text: f.value; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                    if f.kind == "text" : LineEdit { text: f.value; enabled: f.enabled; horizontal-stretch: 1; edited(v) => { root.field-changed(f.id, v); } }
                    if f.kind == "number" : LineEdit { text: f.value; enabled: f.enabled; horizontal-stretch: 1; edited(v) => { root.field-changed(f.id, v); } }
                    if f.kind == "textarea" : LineEdit { text: f.value; enabled: f.enabled; horizontal-stretch: 1; edited(v) => { root.field-changed(f.id, v); } }
                    if f.kind == "boolean" : CheckBox { checked: f.value == "true"; enabled: f.enabled; toggled => { root.field-changed(f.id, self.checked ? "true" : "false"); } }
                    if f.kind == "select" : ComboBox { model: f.options; current-value: f.value; enabled: f.enabled; selected(v) => { root.field-changed(f.id, v); } horizontal-stretch: 1; }
                    if f.kind == "serial" : ComboBox { model: f.options; current-value: f.value; enabled: f.enabled; selected(v) => { root.field-changed(f.id, v); } horizontal-stretch: 1; }
                    if f.kind == "slider" : Slider { value: f.value == "" ? 0 : 0; enabled: f.enabled; changed(v) => { root.field-changed(f.id, v); } horizontal-stretch: 1; }
                    if f.kind == "button" : Button { text: f.label == "" ? "执行" : f.label; enabled: f.enabled; clicked => { root.field-action(f.id); } }
                    if f.kind == "file" : HorizontalBox { spacing: 6px; LineEdit { text: f.value; enabled: f.enabled; horizontal-stretch: 1; } Button { text: "浏览"; enabled: f.enabled; clicked => { root.field-action(f.id); } } }
                    if f.kind == "progress" : ProgressIndicator { progress: f.value == "" ? 0 : 0; }
                    if f.kind == "status" : Text { text: f.value; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                }
            }
        }
        if root.fields.length == 0 : Text { text: "暂无字段 — 等待插件 ui.panel.create"; color: AppColors.text-dimmed; font-size: 11px; }
        if root.fields-json != "[]" : Text { text: root.fields-json; color: AppColors.text-dimmed; font-size: 10px; wrap: word-wrap; }
    }
}
