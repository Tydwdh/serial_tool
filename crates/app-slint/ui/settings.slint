import { Button, ComboBox, LineEdit, VerticalBox, HorizontalBox, GroupBox, TabWidget } from "std-widgets.slint";
import { AppColors } from "palette.slint";

export component SettingsView inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <string> theme-name: "One Dark Pro";
    in-out property <[string]> theme-options: [];
    in-out property <string> recorder-path: "logs/session.jsonl";
    in-out property <string> proxy-url: "";
    in-out property <float> font-size: 13;
    in-out property <int> term-merge-ms: 5;
    in-out property <int> term-max: 50000;
    in-out property <int> log-max: 50000;
    in-out property <string> status: "";

    callback theme-changed(string);
    callback open-theme-folder();
    callback pick-recorder-path();
    callback save();
    callback reset-layout();
    callback font-size-changed(float);
    callback proxy-changed(string);

    VerticalBox {
        padding: 8px;
        spacing: 8px;
        HorizontalBox {
            spacing: 8px;
            Button { text: "常规"; primary: root.tab == 0; clicked => { root.tab = 0; } }
            Button { text: "连接与数据"; primary: root.tab == 1; clicked => { root.tab = 1; } }
            Button { text: "外观"; primary: root.tab == 2; clicked => { root.tab = 2; } }
            Button { text: "关于"; primary: root.tab == 3; clicked => { root.tab = 3; } }
        }
        if root.tab == 0 : GroupBox {
            title: "工作区";
            VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "恢复默认布局"; clicked => { root.reset-layout(); } }
                    Text { text: root.status; color: AppColors.text-secondary; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
        if root.tab == 1 : GroupBox {
            title: "连接与数据";
            VerticalBox {
                spacing: 8px;
                HorizontalBox { spacing: 8px; Text { text: "录制路径"; vertical-alignment: center; } LineEdit { text <=> root.recorder-path; horizontal-stretch: 1; } Button { text: "浏览"; clicked => { root.pick-recorder-path(); } } }
                HorizontalBox { spacing: 8px; Text { text: "代理 URL"; vertical-alignment: center; } LineEdit { text <=> root.proxy-url; placeholder-text: "http://proxy:8080"; horizontal-stretch: 1; edited(t) => { root.proxy-changed(t); } } }
                HorizontalBox { spacing: 8px; Text { text: "终端合并阈值(ms)"; vertical-alignment: center; } LineEdit { text: root.term-merge-ms; width: 64px; } Text { text: "终端保留条数"; vertical-alignment: center; } LineEdit { text: root.term-max; width: 72px; } }
                HorizontalBox { spacing: 8px; Text { text: "日志保留条数"; vertical-alignment: center; } LineEdit { text: root.log-max; width: 72px; } }
            }
        }
        if root.tab == 2 : GroupBox {
            title: "外观";
            VerticalBox {
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "主题"; vertical-alignment: center; }
                    ComboBox { model: root.theme-options; current-value: root.theme-name; selected(v) => { root.theme-changed(v); } horizontal-stretch: 1; }
                    Button { text: "打开主题目录"; clicked => { root.open-theme-folder(); } }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "等宽字体"; vertical-alignment: center; }
                    Button { text: "-"; clicked => { root.font-size-changed(root.font-size - 0.5); } }
                    Text { text: root.font-size + "px"; vertical-alignment: center; }
                    Button { text: "+"; clicked => { root.font-size-changed(root.font-size + 0.5); } }
                }
            }
        }
        if root.tab == 3 : GroupBox {
            title: "关于";
            VerticalBox {
                spacing: 6px;
                Text { text: "Hardware Workbench — Slint 版"; font-weight: 700; }
                Text { text: "基于 Rust + Slint，保留全部功能，剔除 egui 冗余。"; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
            }
        }
        Rectangle { height: 1px; background: AppColors.separator; }
        HorizontalBox {
            alignment: end;
            Button { text: "保存"; primary: true; clicked => { root.save(); } }
        }
    }
}
