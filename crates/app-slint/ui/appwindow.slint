import { Button, LineEdit, ListView, TabWidget, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";
import { ChartView, AttitudeView, GaugeView } from "vis.slint";
import { AppColors } from "palette.slint";

export component AppWindow inherits Window {
    title: "硬件调试工作台 — Slint 预览 (POC)";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 520px;
    icon: @image-url("../../app/../../assets/app-icon-256.png");

    // 状态（后续对接 tool-transport / databus）
    in-out property <string> status-text: "Slint 壳已就绪 — 后续在此对接 core/databus/transport";
    in-out property <string> status-level: "info";
    in-out property <string> rx-preview: "[POC] 终端预览：此处将展示串口/网络串口 RX 流";
    in-out property <string> tx-input: "";
    in-out property <string> log-preview: "[POC] 日志预览";
    in-out property <int> launch-count: 0;

    // 状态：搜索与表格
    in-out property <string> search-text: "";
    in-out property <bool> search-case: false;
    in-out property <string> table-empty: "无数据";

    // 回调（Rust 侧绑定）
    callback tx-send(string);
    callback open-config-folder();
    callback change-theme(string);
    callback search-changed(string);
    callback toggle-search-case();
    callback table-sort(string);
    callback table-select(string);
    // Replay
    in-out property <string> replay-path: "logs/session.jsonl";
    in-out property <string> replay-message: "";
    in-out property <string> replay-status: "";
    in-out property <float> replay-progress: 0;
    in-out property <float> replay-speed: 1;
    in-out property <bool> replay-loop: false;
    in-out property <int> replay-step: 1;
    in-out property <bool> replay-playing: false;
    callback replay-pick-file();
    callback replay-load();
    callback replay-play();
    callback replay-pause();
    callback replay-stop();
    callback replay-prev();
    callback replay-next();
    callback replay-set-speed(float);
    callback replay-set-step(int);
    // Vis
    in-out property <bool> chart-paused: false;
    in-out property <bool> chart-auto: true;
    in-out property <string> chart-legend: "";
    in-out property <string> chart-status: "";
    in-out property <float> att-roll: 0;
    in-out property <float> att-pitch: 0;
    in-out property <float> att-yaw: 0;
    in-out property <int> att-samples: 0;
    in-out property <string> att-source: "none";
    in-out property <float> gauge-value: 0;
    in-out property <float> gauge-min: 0;
    in-out property <float> gauge-max: 100;
    in-out property <string> gauge-unit: "";
    in-out property <string> gauge-label: "";
    in-out property <string> gauge-status: "—";
    in-out property <int> gauge-samples: 0;
    callback chart-toggle-paused();
    callback chart-toggle-auto();
    callback chart-clear();
    callback att-clear();
    callback gauge-clear();
    callback request-close();

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        // 顶部状态栏
        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Text {
                text: "Slint 分支";
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: "·";
                color: #888;
            }
            Text {
                text: root.status-text;
                color: #555;
                font-size: 12px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "打开配置目录";
                clicked => { root.open-config-folder(); }
            }
        }

        // 中部：Tab 承载低难面板与终端/控制（P2）
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "终端";
                HorizontalBox {
                    spacing: 12px;
                    GroupBox {
                        title: "终端 (POC)";
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        VerticalBox {
                            spacing: 6px;
                            Rectangle {
                                background: AppColors.bg-secondary;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: AppColors.border;
                                vertical-stretch: 1;
                                VerticalBox {
                                    padding: 10px;
                                    Text {
                                        text: root.rx-preview;
                                        color: AppColors.text-primary;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: "提示：真实数据流在 tool-transport → tool-databus → 事件总线，Slint 侧通过 callback/timer 订阅即可。";
                                        color: AppColors.text-secondary;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "输入要发送的内容（POC，不真发）";
                                    text <=> root.tx-input;
                                    horizontal-stretch: 1;
                                    accepted(text) => { root.tx-send(text); }
                                }
                                Button {
                                    text: "发送";
                                    primary: true;
                                    clicked => { root.tx-send(root.tx-input); }
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                LineEdit { placeholder-text: "搜索 re:正则 或字面量"; text <=> root.search-text; horizontal-stretch: 1; edited(text) => { root.search-changed(text); } }
                                Button { text: root.search-case ? "Aa*" : "Aa"; clicked => { root.toggle-search-case(); } }
                            }
                        }
                    }
                    VerticalBox {
                        spacing: 10px;
                        width: 360px;
                        GroupBox {
                            title: "控制";
                            VerticalBox {
                                spacing: 8px;
                                Button { text: "模拟一次发送 (计数+1)"; clicked => { root.tx-send(root.tx-input); } }
                                Text { text: "已触发: " + root.launch-count + " 次"; font-size: 12px; color: #444; }
                            }
                        }
                        GroupBox {
                            title: "日志 (POC)";
                            vertical-stretch: 1;
                            ListView {
                                vertical-stretch: 1;
                                for _i in 6 : Rectangle {
                                    height: 28px;
                                    Text { text: root.log-preview + " #" + _i; font-size: 11px; color: #333; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
            Tab {
                title: "回放";
                VerticalBox {
                    spacing: 8px;
                    HorizontalBox {
                        spacing: 8px;
                        LineEdit { text <=> root.replay-path; placeholder-text: "logs/session.jsonl"; horizontal-stretch: 1; }
                        Button { text: "浏览"; clicked => { root.replay-pick-file(); } }
                        Button { text: "加载"; primary: true; clicked => { root.replay-load(); } }
                    }
                    if root.replay-message != "" : Text { text: root.replay-message; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: root.replay-playing ? "暂停" : "播放"; primary: true; clicked => { root.replay-playing ? root.replay-pause() : root.replay-play(); } }
                        Button { text: "停止"; clicked => { root.replay-stop(); } }
                        Button { text: "上一步"; clicked => { root.replay-prev(); } }
                        Button { text: "下一步"; clicked => { root.replay-next(); } }
                    }
                    Text { text: root.replay-status; color: AppColors.text-dimmed; font-size: 11px; }
                    // 进度与倍速
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { height: 8px; border-radius: 4px; background: AppColors.separator; horizontal-stretch: 1; Rectangle { width: parent.width * root.replay-progress; height: 8px; background: AppColors.blue; border-radius: 4px; } }
                        Text { text: (root.replay-progress * 100) + "%"; color: AppColors.text-dimmed; font-size: 11px; }
                    }
                    Text { text: "倍速: " + root.replay-speed + "x  循环:" + (root.replay-loop ? "开" : "关") + "  步长:" + root.replay-step; color: AppColors.text-secondary; font-size: 11px; }
                }
            }
            Tab {
                title: "图表";
                ChartView {
                    paused: root.chart-paused;
                    auto-scale: root.chart-auto;
                    legend: root.chart-legend;
                    status: root.chart-status;
                    toggle-paused => { root.chart-toggle-paused(); }
                    toggle-auto-scale => { root.chart-toggle-auto(); }
                    clear => { root.chart-clear(); }
                }
            }
            Tab {
                title: "姿态";
                AttitudeView {
                    roll: root.att-roll;
                    pitch: root.att-pitch;
                    yaw: root.att-yaw;
                    samples: root.att-samples;
                    source: root.att-source;
                    clear => { root.att-clear(); }
                }
            }
            Tab {
                title: "仪表";
                GaugeView {
                    value: root.gauge-value;
                    min: root.gauge-min;
                    max: root.gauge-max;
                    unit: root.gauge-unit;
                    label: root.gauge-label;
                    status: root.gauge-status;
                    samples: root.gauge-samples;
                    clear => { root.gauge-clear(); }
                }
            }
            Tab {
                title: "数据表";
                VerticalBox {
                    spacing: 6px;
                    Text { text: "声明式表格（插件/回放通用）— 排序/选择已打通，P2 用静态示例"; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
                    GroupBox {
                        title: "示例表";
                        VerticalBox {
                            spacing: 4px;
                            HorizontalBox { spacing: 6px; Button { text: "ID ↑/↓"; clicked => { root.table-sort("id"); } } Button { text: "值 ↑/↓"; clicked => { root.table-sort("value"); } } }
                            Text { text: root.table-empty; color: AppColors.text-dimmed; }
                        }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: end;
            Text {
                text: "分支: slint  |  crates/app-slint  |  cargo run -p hardware-workbench-app-slint";
                font-size: 10px;
                color: #888;
            }
        }
    }
}
