import { Button, LineEdit, ListView, TabWidget, VerticalBox, HorizontalBox, GroupBox } from "std-widgets.slint";
import { ChartView, AttitudeView, GaugeView } from "vis.slint";
import { PluginsView, DynamicFormView } from "plugins.slint";
import { TermRow, LogRow, TerminalView, LogView, DeviceView, SenderView } from "terminal.slint";
import { SettingsView } from "settings.slint";
import { AppColors } from "palette.slint";

export component AppWindow inherits Window {
    title: "硬件调试工作台 — Slint 预览 (POC)";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 520px;
    icon: @image-url("../../app/../../assets/app-icon-256.png");

    in-out property <string> status-text: "就绪";
    in-out property <string> status-level: "info";
    in-out property <string> table-empty: "无数据";
    callback open-config-folder();
    callback table-sort(string);
    callback table-select(string);
    // Replay
    in-out property <string> replay-path: "logs/session.jsonl";
    in-out property <string> replay-message: "";
    in-out property <string> replay-status: "";
    in-out property <float> replay-progress: 0;
    in-out property <float> replay-speed: 1;
    in-out property <bool> replay-loop: false;
    in-out property <int> replay-step: 1;
    in-out property <bool> replay-playing: false;
    callback replay-pick-file();
    callback replay-load();
    callback replay-play();
    callback replay-pause();
    callback replay-stop();
    callback replay-prev();
    callback replay-next();
    callback replay-set-speed(float);
    callback replay-set-step(int);
    // Vis
    in-out property <bool> chart-paused: false;
    in-out property <bool> chart-auto: true;
    in-out property <string> chart-legend: "";
    in-out property <string> chart-status: "";
    in-out property <float> att-roll: 0;
    in-out property <float> att-pitch: 0;
    in-out property <float> att-yaw: 0;
    in-out property <int> att-samples: 0;
    in-out property <string> att-source: "none";
    in-out property <float> gauge-value: 0;
    in-out property <float> gauge-min: 0;
    in-out property <float> gauge-max: 100;
    in-out property <string> gauge-unit: "";
    in-out property <string> gauge-label: "";
    in-out property <string> gauge-status: "—";
    in-out property <int> gauge-samples: 0;
    callback chart-toggle-paused();
    callback chart-toggle-auto();
    callback chart-clear();
    callback att-clear();
    callback gauge-clear();
    // Plugins / Dynamic
    in-out property <int> plugin-tab: 0;
    in-out property <string> plugin-search: "";
    in-out property <string> plugin-market-search: "";
    in-out property <string> plugin-summary: "";
    in-out property <string> plugin-market-error: "";
    in-out property <bool> plugin-market-refreshing: false;
    callback plugin-refresh-market();
    callback plugin-install(string);
    callback plugin-toggle(string);
    callback plugin-uninstall(string);
    callback plugin-restart(string);
    in-out property <string> dynamic-title: "";
    in-out property <string> dynamic-fields-json: "[]";
    callback dynamic-field-changed(string, string);
    callback dynamic-field-action(string);
    // Terminal/Log/Device/Sender
    in-out property <[TermRow]> term-rows: [];
    in-out property <[LogRow]> log-rows: [];
    in-out property <[string]> term-ports: [];
    in-out property <string> term-port-filter: "";
    in-out property <bool> term-show-rx: true;
    in-out property <bool> term-show-tx: true;
    in-out property <bool> term-show-hex: false;
    in-out property <bool> term-show-raw: false;
    in-out property <string> term-search: "";
    in-out property <bool> term-search-case: false;
    in-out property <string> term-status: "";
    in-out property <string> log-search: "";
    in-out property <bool> log-search-case: false;
    in-out property <string> log-level: "info";
    in-out property <string> log-status: "";
    in-out property <[string]> device-ports: [];
    in-out property <string> device-selected: "";
    in-out property <string> device-baud: "115200";
    in-out property <string> device-status: "";
    in-out property <bool> device-dtr: true;
    in-out property <bool> device-rts: true;
    in-out property <string> sender-input: "";
    in-out property <bool> sender-hex: false;
    in-out property <string> sender-ending: "无";
    in-out property <string> sender-error: "";
    in-out property <string> sender-target: "";
    callback term-toggle-rx();
    callback term-toggle-tx();
    callback term-toggle-hex();
    callback term-toggle-raw();
    callback term-search-changed(string);
    callback term-toggle-search-case();
    callback term-port-changed(string);
    callback term-clear();
    callback term-export-txt();
    callback term-export-csv();
    callback term-export-json();
    callback term-select-row(int);
    callback term-copy-selected();
    callback log-search-changed(string);
    callback log-toggle-search-case();
    callback log-level-changed(string);
    callback log-clear();
    callback log-select-row(int);
    callback device-refresh();
    callback device-open();
    callback device-close();
    callback device-port-changed(string);
    callback device-baud-changed(string);
    callback device-dtr-toggled();
    callback device-rts-toggled();
    callback sender-send();
    callback sender-toggle-hex();
    callback sender-ending-changed(string);
    // Settings
    in-out property <int> settings-tab: 0;
    in-out property <string> settings-theme-name: "One Dark Pro";
    in-out property <[string]> settings-theme-options: [];
    in-out property <string> settings-recorder-path: "logs/session.jsonl";
    in-out property <string> settings-proxy: "";
    in-out property <float> settings-font-size: 13;
    in-out property <int> settings-term-merge: 5;
    in-out property <int> settings-term-max: 50000;
    in-out property <int> settings-log-max: 50000;
    in-out property <string> settings-status: "";
    callback settings-theme-changed(string);
    callback settings-open-theme-folder();
    callback settings-pick-recorder();
    callback settings-save();
    callback settings-reset-layout();
    callback settings-font-changed(float);
    callback settings-proxy-changed(string);
    callback request-close();

    VerticalBox {
        padding: 12px;
        spacing: 10px;

        // 顶部状态栏
        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Text {
                text: "Slint 分支";
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: "·";
                color: #888;
            }
            Text {
                text: root.status-text;
                color: #555;
                font-size: 12px;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "打开配置目录";
                clicked => { root.open-config-folder(); }
            }
        }

        // 中部：Tab 承载低难面板与终端/控制（P2）
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "终端";
                TerminalView {
                    rows: root.term-rows;
                    ports: root.term-ports;
                    port-filter: root.term-port-filter;
                    show-rx: root.term-show-rx;
                    show-tx: root.term-show-tx;
                    show-hex: root.term-show-hex;
                    show-raw: root.term-show-raw;
                    search: root.term-search;
                    search-case: root.term-search-case;
                    status: root.term-status;
                    toggle-rx => { root.term-toggle-rx(); }
                    toggle-tx => { root.term-toggle-tx(); }
                    toggle-hex => { root.term-toggle-hex(); }
                    toggle-raw => { root.term-toggle-raw(); }
                    search-changed(t) => { root.term-search-changed(t); }
                    toggle-search-case => { root.term-toggle-search-case(); }
                    port-changed(v) => { root.term-port-changed(v); }
                    clear => { root.term-clear(); }
                    export-txt => { root.term-export-txt(); }
                    export-csv => { root.term-export-csv(); }
                    export-json => { root.term-export-json(); }
                    select-row(id) => { root.term-select-row(id); }
                    copy-selected => { root.term-copy-selected(); }
                }
            }
            Tab {
                title: "日志";
                LogView {
                    rows: root.log-rows;
                    search: root.log-search;
                    search-case: root.log-search-case;
                    level-filter: root.log-level;
                    status: root.log-status;
                    search-changed(t) => { root.log-search-changed(t); }
                    toggle-search-case => { root.log-toggle-search-case(); }
                    level-changed(v) => { root.log-level-changed(v); }
                    clear => { root.log-clear(); }
                    select-row(id) => { root.log-select-row(id); }
                }
            }
            Tab {
                title: "设备";
                DeviceView {
                    ports: root.device-ports;
                    selected-port: root.device-selected;
                    baud: root.device-baud;
                    status: root.device-status;
                    dtr: root.device-dtr;
                    rts: root.device-rts;
                    refresh => { root.device-refresh(); }
                    open => { root.device-open(); }
                    close => { root.device-close(); }
                    port-changed(v) => { root.device-port-changed(v); }
                    baud-changed(v) => { root.device-baud-changed(v); }
                    dtr-toggled => { root.device-dtr-toggled(); }
                    rts-toggled => { root.device-rts-toggled(); }
                }
            }
            Tab {
                title: "发送";
                SenderView {
                    input: root.sender-input;
                    hex-mode: root.sender-hex;
                    line-ending: root.sender-ending;
                    error: root.sender-error;
                    target-port: root.sender-target;
                    send => { root.sender-send(); }
                    toggle-hex => { root.sender-toggle-hex(); }
                    line-ending-changed(v) => { root.sender-ending-changed(v); }
                }
            }
            Tab {
                title: "回放";
                VerticalBox {
                    spacing: 8px;
                    HorizontalBox {
                        spacing: 8px;
                        LineEdit { text <=> root.replay-path; placeholder-text: "logs/session.jsonl"; horizontal-stretch: 1; }
                        Button { text: "浏览"; clicked => { root.replay-pick-file(); } }
                        Button { text: "加载"; primary: true; clicked => { root.replay-load(); } }
                    }
                    if root.replay-message != "" : Text { text: root.replay-message; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
                    HorizontalBox {
                        spacing: 8px;
                        Button { text: root.replay-playing ? "暂停" : "播放"; primary: true; clicked => { root.replay-playing ? root.replay-pause() : root.replay-play(); } }
                        Button { text: "停止"; clicked => { root.replay-stop(); } }
                        Button { text: "上一步"; clicked => { root.replay-prev(); } }
                        Button { text: "下一步"; clicked => { root.replay-next(); } }
                    }
                    Text { text: root.replay-status; color: AppColors.text-dimmed; font-size: 11px; }
                    // 进度与倍速
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { height: 8px; border-radius: 4px; background: AppColors.separator; horizontal-stretch: 1; Rectangle { width: parent.width * root.replay-progress; height: 8px; background: AppColors.blue; border-radius: 4px; } }
                        Text { text: (root.replay-progress * 100) + "%"; color: AppColors.text-dimmed; font-size: 11px; }
                    }
                    Text { text: "倍速: " + root.replay-speed + "x  循环:" + (root.replay-loop ? "开" : "关") + "  步长:" + root.replay-step; color: AppColors.text-secondary; font-size: 11px; }
                }
            }
            Tab {
                title: "图表";
                ChartView {
                    paused: root.chart-paused;
                    auto-scale: root.chart-auto;
                    legend: root.chart-legend;
                    status: root.chart-status;
                    toggle-paused => { root.chart-toggle-paused(); }
                    toggle-auto-scale => { root.chart-toggle-auto(); }
                    clear => { root.chart-clear(); }
                }
            }
            Tab {
                title: "姿态";
                AttitudeView {
                    roll: root.att-roll;
                    pitch: root.att-pitch;
                    yaw: root.att-yaw;
                    samples: root.att-samples;
                    source: root.att-source;
                    clear => { root.att-clear(); }
                }
            }
            Tab {
                title: "仪表";
                GaugeView {
                    value: root.gauge-value;
                    min: root.gauge-min;
                    max: root.gauge-max;
                    unit: root.gauge-unit;
                    label: root.gauge-label;
                    status: root.gauge-status;
                    samples: root.gauge-samples;
                    clear => { root.gauge-clear(); }
                }
            }
            Tab {
                title: "插件";
                PluginsView {
                    tab: root.plugin-tab;
                    search: root.plugin-search;
                    market-search: root.plugin-market-search;
                    summary: root.plugin-summary;
                    market-error: root.plugin-market-error;
                    market-refreshing: root.plugin-market-refreshing;
                    refresh-market => { root.plugin-refresh-market(); }
                    install(id) => { root.plugin-install(id); }
                    toggle(id) => { root.plugin-toggle(id); }
                    uninstall(id) => { root.plugin-uninstall(id); }
                    restart(id) => { root.plugin-restart(id); }
                }
            }
            Tab {
                title: "动态面板";
                DynamicFormView {
                    title: root.dynamic-title;
                    fields-json: root.dynamic-fields-json;
                    field-changed(id, val) => { root.dynamic-field-changed(id, val); }
                    field-action(id) => { root.dynamic-field-action(id); }
                }
            }
            Tab {
                title: "数据表";
                VerticalBox {
                    spacing: 6px;
                    Text { text: "声明式表格（插件/回放通用）— 排序/选择已打通，P2 用静态示例"; color: AppColors.text-secondary; font-size: 11px; wrap: word-wrap; }
                    GroupBox {
                        title: "示例表";
                        VerticalBox {
                            spacing: 4px;
                            HorizontalBox { spacing: 6px; Button { text: "ID ↑/↓"; clicked => { root.table-sort("id"); } } Button { text: "值 ↑/↓"; clicked => { root.table-sort("value"); } } }
                            Text { text: root.table-empty; color: AppColors.text-dimmed; }
                        }
                    }
                }
            }
            Tab {
                title: "设置";
                SettingsView {
                    tab: root.settings-tab;
                    theme-name: root.settings-theme-name;
                    theme-options: root.settings-theme-options;
                    recorder-path: root.settings-recorder-path;
                    proxy-url: root.settings-proxy;
                    font-size: root.settings-font-size;
                    term-merge-ms: root.settings-term-merge;
                    term-max: root.settings-term-max;
                    log-max: root.settings-log-max;
                    status: root.settings-status;
                    theme-changed(v) => { root.settings-theme-changed(v); }
                    open-theme-folder => { root.settings-open-theme-folder(); }
                    pick-recorder-path => { root.settings-pick-recorder(); }
                    save => { root.settings-save(); }
                    reset-layout => { root.settings-reset-layout(); }
                    font-size-changed(v) => { root.settings-font-changed(v); }
                    proxy-changed(v) => { root.settings-proxy-changed(v); }
                }
            }
        }

        HorizontalBox {
            alignment: end;
            Text {
                text: "分支: slint  |  crates/app-slint  |  cargo run -p hardware-workbench-app-slint";
                font-size: 10px;
                color: #888;
            }
        }
    }
}
