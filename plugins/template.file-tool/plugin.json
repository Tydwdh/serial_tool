{
  "$schema": "../plugin.schema.json",
  "id": "template.file-tool",
  "name": "文件工具 (Template)",
  "version": "0.2.0",
  "api_version": "0.1",
  "runtime": "lua",
  "main": "main.lua",
  "description": "文件读取工具模板：通过对话框选择文件并读取内容（演示 fs.read.user_selected 权限）",
  "author": "Tydwdh",
  "homepage": "https://github.com/Tydwdh/serial_tool",
  "repository": "https://github.com/Tydwdh/serial_tool",
  "license": "MIT",
  "category": "template",
  "permissions": ["bus", "log", "ui", "storage", "dialog", "fs.read.user_selected"],
  "live": {
    "main": "main.lua",
    "permissions": ["bus", "log", "ui", "storage", "dialog", "fs.read.user_selected"]
  },
  "contributes": {
    "panels": [
      {
        "id": "file-tool-panel", "title": "文件工具", "kind": "form", "auto_apply": true,
        "fields": [
          {
            "id": "file_path", "label": "文件路径", "kind": "file",
            "filters": [
              { "name": "文本文件", "extensions": ["txt", "log", "csv", "json"] },
              { "name": "所有文件", "extensions": ["*"] }
            ]
          },
          { "id": "file_content", "label": "文件内容", "kind": "textarea", "rows": 10, "default": "" },
          { "id": "load_btn", "label": "加载文件", "kind": "button", "variant": "primary" },
          { "kind": "separator" },
          { "id": "progress", "label": "进度", "kind": "progress", "default": 0 },
          { "id": "status", "label": "状态", "kind": "status", "default": { "text": "就绪", "level": "idle" } },
          { "id": "stats", "label": "统计信息", "kind": "label", "text": "" }
        ]
      }
    ]
  }
}
